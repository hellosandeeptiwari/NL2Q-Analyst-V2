# Production Environment Variables Template
# Use this template for production Azure deployments

# ==========================================
# DATABASE CONFIGURATION (Azure SQL)
# ==========================================
DB_HOST=odsproduction.database.windows.net
DB_PORT=1433
DB_USER=your_production_db_user
DB_PASSWORD=your_production_db_password
DB_NAME=DWHPRODIBSA

# ==========================================
# OPENAI CONFIGURATION
# ==========================================
OPENAI_API_KEY=your_production_openai_key
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# PINECONE CONFIGURATION
# ==========================================
PINECONE_API_KEY=your_production_pinecone_key
PINECONE_ENVIRONMENT=your_production_environment
PINECONE_INDEX_NAME=your_production_index

# ==========================================
# APPLICATION SETTINGS
# ==========================================
LOG_LEVEL=WARNING
PYTHONUNBUFFERED=1
ENABLE_ORYX_BUILD=true
SCM_DO_BUILD_DURING_DEPLOYMENT=true

# ==========================================
# FRONTEND CONFIGURATION (Production URLs)
# ==========================================
# Replace with your actual Azure App Service backend URL
REACT_APP_API_URL=https://your-backend-app.azurewebsites.net

# ==========================================
# AZURE-SPECIFIC SETTINGS
# ==========================================
# These are automatically set by Azure App Service
# WEBSITE_HOSTNAME=
# WEBSITE_SITE_NAME=
# WEBSITE_RESOURCE_GROUP=
